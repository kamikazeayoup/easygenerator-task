{
  "name": "easygenerator-task",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": "24.22.2", "npm": "11.19.1" },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "npm run dev -w @easygenerator/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "start": "npm run start -w @easygenerator/api",
    "test": "npm run build -w @easygenerator/api && node --test apps/api/test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
